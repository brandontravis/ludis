# ============================================================
# LUDIS CONFIGURATION FILE (SAMPLE)
# ============================================================
# Copy this file to 'config.yaml' and customize for your setup
#
# Quick Start:
#   1. Copy: cp config.yaml.sample config.yaml
#   2. Edit paths below to match your system
#   3. Run: python3 ludis.py
# ============================================================

# Ludis version (schema version for future migrations)
version: "2.0"

# ============================================================
# PATH CONFIGURATION
# ============================================================
paths:
  # LaunchBox data directory (where Platform and Playlist XMLs are stored)
  # IMPORTANT: We recommend copying LaunchBox/Data/ to ludis/Data/ and
  #            removing unwanted platforms/playlists before running.
  # Default: "Data/" (relative to this script)
  launchbox_data: "Data/"
  
  # Output directory for all generated CSVs
  # Default: "LB_Exports/" (relative to this script)
  output_directory: "LB_Exports/"
  
  # Windows root path (as used by LaunchBox internally)
  # This is the path LaunchBox stores in its XML files
  # Example: "Z:\\media\\games\\library"
  windows_root: "Z:\\media\\games\\library"
  
  # Base library path (the root directory containing all your game folders)
  # This is used to calculate relative paths for all games
  # Example: "/Volumes/The_Stacks/media/games/library"
  library_base_path: "/Volumes/The_Stacks/media/games/library"
  
  # Library scan paths (where to look for platform folders)
  # If you have a flat structure, this will be the same as library_base_path
  # If nested (e.g., library/Consoles/, library/Handhelds/), list each category
  # 
  # Single location example:
  #   library_roots:
  #     - "/Volumes/The_Stacks/media/games/library"
  #
  # Nested structure example:
  #   library_roots:
  #     - "/Volumes/The_Stacks/media/games/library/Consoles"
  #     - "/Volumes/The_Stacks/media/games/library/Handhelds"
  library_roots:
    - "/Volumes/The_Stacks/media/games/library"

# ============================================================
# PROCESSING OPTIONS
# ============================================================
options:
  # Enable filesystem scanning to build inventory
  # 
  # If TRUE:  Scans library paths to build filesystem inventory and matches
  #           LaunchBox entries to actual files on disk
  # If FALSE: Skips filesystem scan, exports LaunchBox metadata only
  #           (useful for metadata-only exports or when files aren't accessible)
  # 
  # Default: true
  scan_filesystem: true
  
  # Enable verbose output (detailed logging)
  # Default: false
  verbose: false
  
  # Show progress bars for long operations
  # Default: true
  show_progress: true
  
  # Ignore patterns for files and folders during scanning
  # Uses glob-style patterns (* matches any characters)
  ignore_patterns:
    # Files to skip (system files, metadata files, etc.)
    files:
      - ".DS_Store"        # macOS metadata
      - "Thumbs.db"        # Windows thumbnail cache
      - "desktop.ini"      # Windows folder settings
      - "._*"              # macOS resource forks (any file starting with ._ )
    
    # Folders to skip (system folders, hidden folders, etc.)
    folders:
      - "_*"               # Any folder starting with underscore
      - ".git"             # Git repository folders
      - ".svn"             # SVN repository folders
      # Add custom patterns here:
      # - "System"         # Skip folders named "System"
      # - "Updates"        # Skip folders named "Updates"
      # - "*backup*"       # Skip any folder with "backup" in the name
  
  # Path overrides (for files that moved after LaunchBox imported them)
  # If your game files moved to a different location after LaunchBox scanned them,
  # the paths in LaunchBox XML won't match your current filesystem structure.
  # Use this to map old paths to new paths (case-insensitive matching).
  #
  # Format: "old/path/in/launchbox": "new/actual/path/on/disk"
  #
  # Common NEC platform path corrections:
  path_overrides:
    consoles/nec - turbografx 16 - pc engine [1987]: Consoles/NEC TurboGrafx-16 (PC Engine) [1987]
    consoles/nec turbografx 16 (pc engine) [1987]: Consoles/NEC TurboGrafx-16 (PC Engine) [1987]
    consoles/nec turbografx-cd [1988]: Consoles/NEC TurboGrafx-CD (PC Engine CD-Rom) [1988]
    consoles/nec turbografx-cd (pc engine cd-rom) [1988]: Consoles/NEC TurboGrafx-CD (PC Engine CD-Rom) [1988]
    consoles/nec pc engine supergrafx [1989]: Consoles/NEC PC Engine SuperGrafx [1989]

# ============================================================
# PLATFORM STRUCTURE CONFIGURATION
# ============================================================
# Populated by interactive platform discovery (Setup & Configuration menu)
# Defines how each platform is organized and should be scanned
#
# Platform types:
#   - files:  Platform folder contains ROM files directly
#   - folders: Platform folder contains game folders (one folder per game)
#   - nested: Platform has subfolders that need individual configuration
#   - skip: Don't scan this platform
#
# Example configurations:
platform_structure:
  # Simple file-based platform
  # "Nintendo 64":
  #   path: "/Volumes/The_Stacks/media/games/library/Consoles/Nintendo 64"
  #   type: "files"
  
  # Simple folder-based platform
  # "Sony Playstation 3":
  #   path: "/Volumes/The_Stacks/media/games/library/Consoles/Sony Playstation 3"
  #   type: "folders"
  
  # Complex nested platform (configured interactively)
  # "Nintendo Wii U":
  #   path: "/Volumes/The_Stacks/media/games/library/Consoles/Nintendo Wii U"
  #   type: "nested"
  #   scan_paths:
  #     - path: "Games"
  #       type: "files"
  #     - path: "[Loadiine]"
  #       type: "folders"
  
  # Skipped platform (won't be scanned)
  # "Arcade":
  #   path: "/Volumes/The_Stacks/media/games/library/Arcade"
  #   type: "skip"

# ============================================================
# EXPORT TARGETS
# ============================================================
# Configure destinations for ROM migrations (e.g., Steam Deck, Retro handheld)
# Multiple targets can be defined but only one can be active per migration
export_targets:
  steam_deck:
    enabled: true
    format: "esde"  # ES-DE format (EmulationStation Desktop Edition)
    
    # Base paths for ROM storage locations
    # These are filled in during first migration or can be pre-configured
    storage_locations:
      internal_ssd:
        path: ""  # e.g., "/home/deck/Emulation/roms"
        label: "Internal SSD"
      sd_card:
        path: ""  # e.g., "/run/media/mmcblk0p1/Emulation/roms"
        label: "SD Card"
    
    # Platform storage defaults - configures where each platform goes by default
    # This is configured via "Configure Platform Storage Defaults" menu option
    # Values: "internal_ssd", "sd_card", "custom"
    # Example:
    # platform_storage_defaults:
    #   "Nintendo Entertainment System": "internal_ssd"
    #   "Nintendo Wii U": "sd_card"
    #   "Sony Playstation 3": "custom"
    
    # Default migration preferences (can be changed per migration)
    defaults:
      operation: "copy"  # "copy" or "symlink"
      
      # Migration filters will be configured during migration script generation
      # based on your LaunchBox custom fields and playlists
      filters: {}
  
  # Example: Another handheld device
  retroid_pocket:
    enabled: false
    format: "esde"
    storage_locations:
      internal:
        path: ""
        label: "Internal Storage"
      sd_card:
        path: ""
        label: "SD Card"
    defaults:
      operation: "copy"
      filters: {}

# ============================================================
# MIGRATION HISTORY
# ============================================================
# Stores configurations from previous migrations
# This allows you to quickly reuse previous settings
# (Auto-populated by Build Migration Script - do not edit manually)
migration_history:
  last_migration: null  # Timestamp of most recent migration
  
  configurations: []
    # Example entry (auto-generated):
    # - timestamp: "2025-11-18T15:30:00"
    #   export_target: "steam_deck"
    #   operation: "symlink"
    #   platforms:
    #     - name: "Nintendo Wii U"
    #       storage: "sd_card"
    #       game_count: 754
    #     - name: "Sony Playstation 3"
    #       storage: "internal_ssd"
    #       game_count: 1234
    #   filters: {}
    #   total_games: 1988
    #   total_size_bytes: 524288000000

